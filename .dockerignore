storage/app/public/*

# The squashed schema is loaded through the `mysql` CLI by Laravel, which
# forces TLS on recent MariaDB clients. Excluding it makes `migrate` import the
# individual migrations over PDO, which works with or without DB TLS.
database/schema/*.sql

tests
phpunit.xml
phpunit.xml.dist
phpstan.neon
phpstan-baseline.neon
